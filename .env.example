# public/config.json is read at page load and overrides everything here, and
# public/config.local.json overrides that. Prefer those — editing them needs no
# rebuild. This file is only the bottom fallback layer, useful for local dev.
#
# There is no mock/demo mode: the project runs on real data only.

# Which data source the app reads from.
#   sheets - Google Sheets CSV (or local CSV files during development). Default.
#   api    - your own backend (see src/data/apiAdapter.js for the contract).
VITE_DATA_SOURCE=sheets

# --- login ----------------------------------------------------------------
# Server-side roster lookup. On Netlify this is /api/lookup, backed by
# netlify/functions/lookup.js. The function needs ROSTER_CSV_URL — and
# ADMIN_EMAILS for staff — set in the SERVER environment, not here.
VITE_ROSTER_API_URL=/api/lookup

# --- trip content ---------------------------------------------------------
# Share link of the spreadsheet holding the trip tabs, or a bare file id. Tabs
# are found BY NAME (Trips, Itinerary, Documents, Guidelines, Reminders,
# Travel, Media), so this is normally the only value needed.
VITE_SHEET_ID=

# Tab holding per-source link overrides. Blank links there mean "use the tab of
# the same name in this file".
VITE_SETTINGS_TAB=Settings

# Only needed if a tab has been RENAMED — a gid survives renames and wins over
# the tab name. Normally leave all of these blank.
VITE_GID_TRIPS=
VITE_GID_ITINERARY=
VITE_GID_DOCUMENTS=
VITE_GID_GUIDELINES=
VITE_GID_REMINDERS=
VITE_GID_TRAVEL=
VITE_GID_MEDIA=

# If sources live in SEPARATE spreadsheet files, set a file id per source.
# These win over VITE_SHEET_ID.
VITE_SHEET_ID_TRIPS=
VITE_SHEET_ID_ITINERARY=
VITE_SHEET_ID_DOCUMENTS=
VITE_SHEET_ID_GUIDELINES=
VITE_SHEET_ID_REMINDERS=
VITE_SHEET_ID_TRAVEL=
VITE_SHEET_ID_MEDIA=

# --- Drive folder discovery (optional) ------------------------------------
# Drive folder share link. The app lists it and matches spreadsheets to sources
# BY FILE NAME. Needs VITE_GOOGLE_API_KEY.
VITE_DRIVE_FOLDER_ID=

# API key with the Google Drive API enabled, restricted by HTTP referrer. Also
# turns a folder link in the Documents tab into one card per file.
VITE_GOOGLE_API_KEY=

VITE_DRIVE_API_BASE=

# --- Google Sign-In (optional) --------------------------------------------
# OAuth 2.0 Web client id. When set, the login page shows "Sign in with Google"
# and Google proves the parent's email instead of them typing it. Add the app's
# origin to the client's authorised JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# --- local development only -----------------------------------------------
# Read CSV files from a path instead of Google. Blank in production.
VITE_SHEET_CSV_BASE=

# --- api adapter ----------------------------------------------------------
VITE_API_BASE_URL=
