# NOTE: public/config.json is read at page load and overrides everything here.
# Prefer it for anything deployed — editing it needs no rebuild. This file is
# the fallback, and is most useful for local development.
#
# Which data source the app reads from.
#   mock   - local sample data, no network. Default.
#   sheets - published-to-web Google Sheets CSV, read straight from the browser.
#   api    - your own backend (see src/data/apiAdapter.js for the contract).
VITE_DATA_SOURCE=mock

# --- sheets adapter -------------------------------------------------------
# Offline demo: run the real sheets adapter against the CSV fixtures in
# public/sample-sheets/ instead of Google. Same parser, same normalizers — only
# the URL differs. Set this and the Google ids below are ignored.
VITE_SHEET_CSV_BASE=

# Drive folder share link. The app lists the folder and matches spreadsheets to
# sources BY FILE NAME. Needs VITE_GOOGLE_API_KEY below.
VITE_DRIVE_FOLDER_ID=

# The spreadsheet's share link, or a bare file id. Tabs are found BY NAME
# (Students, Trips, Itinerary, …), so this is normally the only value needed.
VITE_SHEET_ID=

# Tab holding per-source link overrides. Blank links there mean "use the tab of
# the same name in this file".
VITE_SETTINGS_TAB=Settings

# Only needed if a tab has been RENAMED — a gid survives renames and wins over
# the tab name. Normally leave all of these blank.
VITE_GID_STUDENTS=
VITE_GID_TRIPS=
VITE_GID_ITINERARY=
VITE_GID_DOCUMENTS=
VITE_GID_GUIDELINES=
VITE_GID_REMINDERS=
VITE_GID_TRAVEL=
VITE_GID_MEDIA=

# If tabs live in SEPARATE spreadsheet files instead, leave the gids blank and
# set a file id per sheet. These win over VITE_SHEET_ID when present.
VITE_SHEET_ID_STUDENTS=
VITE_SHEET_ID_TRIPS=
VITE_SHEET_ID_ITINERARY=
VITE_SHEET_ID_DOCUMENTS=
VITE_SHEET_ID_GUIDELINES=
VITE_SHEET_ID_REMINDERS=
VITE_SHEET_ID_TRAVEL=
VITE_SHEET_ID_MEDIA=

# --- Google Sign-In (optional) --------------------------------------------
# OAuth 2.0 Web client id from Google Cloud Console. When set, the login page
# shows a "Sign in with Google" button and Google proves the parent's email
# address instead of them simply typing it. Add your app's origin to the
# client's "Authorised JavaScript origins".
# Leave blank to fall back to the typed email/mobile box only.
VITE_GOOGLE_CLIENT_ID=

# --- Drive folder expansion (optional) ------------------------------------
# API key with the Google Drive API enabled, restricted by HTTP referrer. When
# set, a Documents row holding a FOLDER link expands into one card per file in
# that folder. Blank = folder rows stay a single link card.
VITE_GOOGLE_API_KEY=

# Leave blank for Google. Set to /sample-drive to demo expansion offline.
VITE_DRIVE_API_BASE=

# --- api adapter ----------------------------------------------------------
VITE_API_BASE_URL=
